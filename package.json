{
  "name": "backlens",
  "version": "0.6.1",
  "description": "See what your Node backend really does on every request, catch what a change broke across every route, and prove fixes by replay. A local recorder, dashboard and MCP server, with a stop hook for coding agents.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "backlens": "bin/backlens.js"
  },
  "exports": {
    "./register": "./src/recorder/index.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "statusline.js",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check-syntax.mjs",
    "prepublishOnly": "npm run check && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0"
  },
  "peerDependencies": {
    "typescript": ">=4.7"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shayandutta/backlens.git"
  },
  "homepage": "https://github.com/shayandutta/backlens#readme",
  "bugs": {
    "url": "https://github.com/shayandutta/backlens/issues"
  },
  "keywords": [
    "node",
    "backend",
    "performance",
    "n+1",
    "postgres",
    "redis",
    "tracing",
    "profiling",
    "devtools",
    "mcp",
    "claude-code",
    "ai-agents",
    "regression-testing",
    "replay"
  ],
  "author": "Shayan Dutta"
}
